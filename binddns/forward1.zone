## Forward Zone Config For 3 controlplane and 3 worker nodes 
$TTL 1W
@       IN      SOA     bastion.ocp.pdlab.sg.   root (
                        2019070700      ; serial
                        3H              ; refresh (3 hours)
                        30M             ; retry (30 minutes)
                        2W              ; expiry (2 weeks)
                        1W )            ; minimum (1 week)
        IN      NS      bastion.ocp.pdlab.sg.
bastion         IN      A       192.168.96.101
;
api             IN      A       192.168.96.101
api-int         IN      A       192.168.96.101
;
*.apps          IN      A       192.168.96.101
;
bootstrap       IN      A       192.168.96.102
;
master1         IN      A       192.168.96.111
master2         IN      A       192.168.96.112
master3         IN      A       192.168.96.113
;
worker1         IN      A       192.168.96.114
worker2         IN      A       192.168.96.115
worker3         IN      A       192.168.96.116
;
