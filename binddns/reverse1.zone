## DNS Reverse Zone Config - 3 control plane, 3 worker nodes
$TTL 1W
@       IN      SOA     bastion.ocp.lab.sg.   root (
                        2019070700      ; serial
                        3H              ; refresh (3 hours)
                        30M             ; retry (30 minutes)
                        2W              ; expiry (2 weeks)
                        1W )            ; minimum (1 week)
                IN      NS      bastion.ocp.lab.sg.
;
101             IN      PTR     api.ocp.lab.sg.
101             IN      PTR     api-int.ocp.lab.sg. 
;
102             IN      PTR     bootstrap.ocp.lab.sg. 
;
111             IN      PTR     master1.ocp.lab.sg. 
112             IN      PTR     master2.ocp.lab.sg. 
113             IN      PTR     master3.ocp.lab.sg. 
;
114             IN      PTR     worker1.ocp.lab.sg.
115             IN      PTR     worker2.ocp.lab.sg.
116             IN      PTR     worker3.ocp.lab.sg.
;
